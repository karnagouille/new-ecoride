{% extends 'base.html.twig' %}

{% block title %}Register
{% endblock %}

{% block body %}
	{% for flash_error in app.flashes('verify_email_error') %}
		<div class="alert alert-danger" role="alert">{{ flash_error }}</div>
	{% endfor %}
	{% block stylesheets %}
		{{ parent() }}
		<link rel="stylesheet" href="{{ asset('css/style.css') }}">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
		<script src="{{ asset('script/main.js') }}" defer></script>
	{% endblock %}


	{{ form_errors(registrationForm) }}
	{{ form_start(registrationForm) }}
	<div class="log ">
		

		<div class="log">
			<div >
				<div><img src="/image/connexion.png" alt="" class="imglog"></div>
			</div>

			<div >
				<div><h1 class="h3 mb-3 font-weight-normal infolog titleshadow">S'ENREGISTRER</h1></div>
			</div>

			<div class="accountext">
				<label>
					<span>Pseudo</span>
					{{ form_widget(registrationForm.pseudo) }}
				</label>
			</div>
			<div class="accountext">
				<label>
					<span>Nom</span>
					{{ form_widget(registrationForm.lastname) }}
				</label>
			</div>
			<div class="accountext">
				<label>
					<span>Prénom</span>
					{{ form_widget(registrationForm.name) }}
				</label>
			</div>
			<div class="accountext">
				<label>
					<span>Email</span>
					{{ form_widget(registrationForm.email) }}
				</label>
			</div>
			<div class="accountext">
				<label>
					<span>Mot de passe</span>
					{{ form_widget(registrationForm.plainPassword.first) }}
				</label>
			</div>
			<div class="accountext">
				<label>
					<span>Comfirmer le mot de passe</span>
					{{ form_widget(registrationForm.plainPassword.second) }}
				</label>
			</div>
		</div>
		<button type="submit" class="btn">s'enregistrer</button>
	</div>

	{{ form_end(registrationForm) }}
{% endblock %}
