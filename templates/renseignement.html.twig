{% extends 'base.html.twig' %}

{% block title %}Covoiturage
{% endblock %}

{% block body %}
	{% block stylesheets %}
		{{ parent() }}
		<link rel="stylesheet" href="{{ asset('css/style.css') }}">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
		<script src="{{ asset('script/main.js') }}" defer></script>
	{% endblock %}

<div class="reserved">
<div class="backgroundhistorical">
				<div class="profilhistorical">

					<div class="profil">	
						<div>
							<div class="pseudo">{{trajet.user.pseudo}}</div>
						</div>
						
						<div class="userimgsearch">
							<div><a href="{{ path('renseignement', {'id': trajet.id}) }}"></div>
							<div><img class="picturesprofilsearch" src="{{ asset('uploads/' ~ trajet.user.photo) }}" alt="Photo de profil"></a></div>
						</div>

						<div>
							<p><strong>Note : {{ average|round(2) }}/5</strong></p>
						</div>
					</div>
					
					<div class="gapcollum2">
						<div class="destination">
								<div></p><strong>{{ trajet.startAt|date('d/m/Y') }}</strong></p></div>
								<div><p><em>Durée environ {{ trajet.travelTime }} H</em></p></div>
						</div>
							
						<div class="startfinish">
							<div><p><strong>Départ : {{ trajet.startTown }}</strong></p></div>
						</div>

						<div>-----------------------------------</div>

						<div class="startfinish">
							<div>
								<p><strong>Arrivée : {{ trajet.endTown }}</strong></p>
							</div>
						</div>

						<div class="preference">
							<div>
								<div><strong>Préférence : {{ carpooling.car.preference }}</strong></div>
							</div>
						</div>
					</div>	
	
						<div class="priceplacehistorical">
							<div><strong>{{ trajet.hour ? trajet.hour|date('H:i') : '' }}</strong>{% if trajet.electric %} <img class="eleccar" src="{{ asset('image/voiture-electrique.png') }}" alt="icone voiture electrique">
							{% endif %}
							<p><strong>{{ trajet.passenger }} place(s)</strong></p>
							</div>

							
					<div class="brand">
						<div><strong>Voiture :</strong></div>
						<div><strong>Model : {{ carpooling.car.model }}</strong></div>
						<div><strong>Couleur : {{ carpooling.car.color }}</strong></div>
						<div><strong>Energie : {{ carpooling.car.energy }}</strong></div>
					</div>

							{% set transaction = trajet.creditTransactions.first %}
							<div>
								<p><strong>{{ transaction ? transaction.amount : 'Non défini' }}€</strong></p>
							</div>
						</div>

				</div>
			</div>
</div>
		<div class="titlecomment">
			<div>
				<strong>COMMENTAIRES</strong>
			</div>
		</div>
		{% if canComment %}

			{{form_start(form)}}
			<div class="comment0">
				<div class="comment1bis">

					<div class="comment">
						<div>
							<div>{{form_widget(form.comment)}}</div>
						</div>
					</div>
					<div class="comment">
						<div>
							<div>Note
								{{form_widget(form.note)}}</div>
						</div>
					</div>
					<button type="submit">Valider</button>
					<br>
				</div>
			</div>
			{{form_end(form)}}
		{% endif %}


		{% for comment in comments %}
			{% if comment.statut == 'checked' %}
				<div class="comment0">
					<div class="comment1">

						<div class="comment">
							<div>
								<div><img class="userimg3 " src="{{ asset('uploads/' ~ comment.user.photo) }}" alt="Photo de profil"></div>
								<div>
									<p>
										<strong>{{ comment.user.pseudo }}</strong>
									</p>
								</div>
							</div>
						</div>

						<div class="comment">
							<div>
								<div>{{comment.comment}}</div>
							</div>
						</div>

						<div class="comment">
							<div>
								<div>{{comment.note}}/5</div>
							</div>
						</div>

					</div>
				</div>
			{% endif %}
		{% endfor %}
	{% endblock %}
