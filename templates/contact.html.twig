{% extends 'base.html.twig' %}

{% block title %}Covoiturage
{% endblock %}

{% block body %}
	{% block stylesheets %}
		{{ parent() }}
		<link rel="stylesheet" href="{{ asset('css/style.css') }}">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
		<script src="{{ asset('script/main.js') }}" defer></script>
	{% endblock %}

	<div class ="titlecontact">
		<h1><u>Contactez notre support</u></h1>
		<p>Vous avez une question ou rencontrez un problème ?</p>
		<p> Remplissez ce formulaire et notre équipe vous répondra dans les plus brefs délais.</p>
	</div>
<div class="contactform">
    {{form_start(form)}}
	<div class="contactform1">
		<div class="accountext">
			<div>
				<label for="">Nom</label>
			</div>
			<div>{{ form_widget(form.name) }}</div>
		</div>

		<div class="accountext">
			<div>
				<label for="">Adresse mail</label>
			</div>
			<div>{{ form_widget(form.email) }}</div>
		</div>

		<div class="accountext">
			<div>
				<label for="">Votre message</label>
			</div>
			<div >{{ form_widget(form.message) }}</div>
		</div >
		<div class = "button-send">
			<div>
				<button class="findCheck1" type="submit">Envoyer</button>
			</div>
		</div>

	</div>		
{{form_end(form)}}
</div>
    {% endblock %}


